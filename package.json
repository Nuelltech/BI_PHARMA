{
  "name": "bi-pharma-etl",
  "version": "1.0.0",
  "description": "Motor de ETL e Inteligência de Inventário Farmacêutico (Fase 1 - Backend e Base de Dados)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node -e \"if (!require('fs').existsSync('dist/server.js')) { require('child_process').execSync('npm run build', { stdio: 'inherit' }); } require('./dist/server.js');\"",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "etl": "tsx src/cli.ts etl",
    "analyze": "tsx src/cli.ts analyze",
    "pipeline": "tsx src/cli.ts pipeline",
    "seed:supabase": "tsx src/seed_supabase.ts",
    "audit:supabase": "tsx src/audit_db_parity.ts",
    "dashboard": "tsx src/server.ts",
    "benchmark": "tsx scripts/load_test_harness.ts",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.5.0",
    "@simplewebauthn/server": "^14.1.0",
    "bullmq": "^6.7.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "iconv-lite": "^0.6.3",
    "ioredis": "^6.0.0",
    "libpg-query": "^18.2.4",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.5.0",
    "qrcode-terminal": "^0.12.0",
    "resend": "^6.39.0",
    "tsx": "^4.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "optionalDependencies": {
    "embedded-postgres": "latest"
  }
}
