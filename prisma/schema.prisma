generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// TABELAS DE DOMÍNIO E MULTI-TENANT
// ==========================================
model Organizacao {
  id             String          @id @default(uuid())
  nome           String
  nif            String?         @unique
  plano          String          @default("PILOTO") // "PILOTO" | "PRO" | "ENTERPRISE"
  farmacias      Farmacia[]
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
}

model Farmacia {
  id                  String              @id @default(uuid())
  organizacaoId       String?
  organizacao         Organizacao?        @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)
  nome                String
  nif                 String              @unique
  slug                String?             @unique
  morada              String?
  estado              String              @default("ATIVO") // "ATIVO" | "SUSPENSA" | "INATIVA"
  planoSaas           String              @default("PILOTO") @map("plano_saas")
  acessoLegadoAte     DateTime?           @map("acesso_legado_ate")
  codigo_acesso       String?             @unique
  membros             MembroEquipa[]
  membrosFarmacia     MembroFarmacia[]
  sessoes             SessaoUtilizador[]
  sessoesV2           Sessao[]
  dispositivosBalcao  DispositivoBalcao[]
  codigosEmparelh     CodigoEmparelhamento[]
  consentimentosSup   ConsentimentoSuporte[]
  inventarios         Inventario[]
  vendas              Venda[]
  stagingInventario   StagingInventario[]
  stagingVendas       StagingVendas[]
  stagingValidades    StagingValidades[]
  inventariosSnapshot InventarioSnapshot[]
  precos              PrecoFarmacia[]
  tarefasEquipa       TarefaEquipa[]
  campanhasAtivas     CampanhaAtiva[]
  copilotUsageLogs    CopilotUsageLog[]
  mcpPermitido        Boolean             @default(true)
  mcpConnectors       McpConnector[]
  mcpAuditLogs        McpAuditLog[]
  martTenantKpis      MartTenantKpis?
  martProdutoMetricas MartProdutoMetricas[]
  martProdutoMes      MartProdutoMes[]
  martDciGrupos       MartDciGrupo[]
  criadoEm            DateTime            @default(now())
}

model Utilizador {
  id                 String                @id @default(uuid())
  email              String?               @unique
  nome               String
  telemovel          String?
  passwordHash       String?               @map("password_hash")
  emailVerificadoEm  DateTime?             @map("email_verificado_em")
  ativo              Boolean               @default(true)
  isSuperadmin       Boolean               @default(false) @map("is_superadmin")
  totpSecretEnc      String?               @map("totp_secret_enc")
  totpAtivo          Boolean               @default(false) @map("totp_ativo")
  totpUltimoPasso    BigInt?               @map("totp_ultimo_passo")
  totpRecoveryHashes String[]              @default([]) @map("totp_recovery_hashes")
  passwordAlteradaEm DateTime?             @map("password_alterada_em")
  membroEquipas      MembroEquipa[]
  vinculosFarmacia   MembroFarmacia[]
  sessoes            SessaoUtilizador[]
  sessoesV2          Sessao[]
  dispositivosConf   DispositivoConfiado[]
  credenciaisPasskey CredencialPasskey[]
  criadoEm           DateTime              @default(now())
  atualizadoEm       DateTime              @updatedAt
}

model MembroEquipa {
  id               String              @id @default(uuid())
  farmaciaId       String
  utilizadorId     String?
  nome             String
  email            String
  role             String              @default("AUXILIAR") // "DIRETOR" | "GESTOR" | "AUXILIAR" | "SUPORTE"
  pin              String?             // LEGADO — invalidado na Fase 0 (nunca usar em texto claro)
  pinHash          String?             // HMAC-SHA256 versionado com pepper + salt por vínculo
  pinAlteradoEm    DateTime?
  pinFalhas        Int                 @default(0)
  pinBloqueadoAte  DateTime?
  pinTemporario    Boolean             @default(false)
  ativo            Boolean             @default(true)
  ultimoAcessoEm   DateTime?
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  farmacia         Farmacia            @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  utilizador       Utilizador?         @relation(fields: [utilizadorId], references: [id], onDelete: SetNull)

  @@unique([farmaciaId, email])
  @@index([farmaciaId])
  @@index([utilizadorId])
}

model SessaoUtilizador {
  id               String              @id @default(uuid())
  token            String              @unique
  farmaciaId       String
  utilizadorId     String?
  userName         String
  userEmail        String?
  role             String              @default("AUXILIAR")
  ip               String?
  device           String?
  criadoEm         DateTime            @default(now())
  ultimoAcessoEm   DateTime            @default(now())
  expiraEm         DateTime

  farmacia         Farmacia            @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  utilizador       Utilizador?         @relation(fields: [utilizadorId], references: [id], onDelete: SetNull)

  @@index([farmaciaId])
  @@index([token])
  @@index([expiraEm])
}

model TokenRecuperacao {
  id               String              @id @default(uuid())
  token            String              @unique
  email            String
  farmaciaId       String?
  expiraEm         DateTime
  usadoEm          DateTime?
  criadoEm         DateTime            @default(now())

  @@index([token])
  @@index([email])
}

model SessaoAdmin {
  id               String              @id @default(uuid())
  token            String              @unique
  ip               String?
  userAgent        String?
  criadoEm         DateTime            @default(now())
  expiraEm         DateTime

  @@index([token])
}

model LimiteTaxa {
  chave            String              @id
  janelaInicio     DateTime            @map("janela_inicio")
  contador         Int                 @default(1)
  bloqueadoAte     DateTime?           @map("bloqueado_ate")
  atualizadoEm     DateTime            @updatedAt @map("atualizado_em")

  @@index([janelaInicio])
  @@map("limites_taxa")
}

// ==========================================
// FASE 1 — IDENTIDADE, VÍNCULOS, SESSÕES OPACAS E AUDITORIA (Spec v2.1)
// ==========================================

model MembroFarmacia {
  id               String              @id @default(uuid())
  utilizadorId     String?             @map("utilizador_id")
  farmaciaId       String              @map("farmacia_id")
  nome             String
  perfil           String              @default("OPERADOR_BALCAO") // PROPRIETARIO | DIRETOR_TECNICO | COMPRADOR | OPERADOR_BALCAO
  permissoesExtra  String[]            @default([]) @map("permissoes_extra")
  farmaciaPadrao   Boolean             @default(false) @map("farmacia_padrao")
  estado           String              @default("PENDENTE") // PENDENTE | ATIVO | SUSPENSO
  pinHash          String?             @map("pin_hash")
  pinAlteradoEm    DateTime?           @map("pin_alterado_em")
  pinFalhas        Int                 @default(0) @map("pin_falhas")
  pinBloqueadoAte  DateTime?           @map("pin_bloqueado_ate")
  pinTemporario    Boolean             @default(false) @map("pin_temporario")
  ultimoAcessoEm   DateTime?           @map("ultimo_acesso_em")
  criadoEm         DateTime            @default(now()) @map("criado_em")
  atualizadoEm     DateTime            @updatedAt @map("atualizado_em")

  farmacia         Farmacia            @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  utilizador       Utilizador?         @relation(fields: [utilizadorId], references: [id], onDelete: SetNull)
  sessoes          Sessao[]

  @@unique([utilizadorId, farmaciaId])
  @@index([farmaciaId])
  @@index([utilizadorId])
  @@map("membros_farmacia")
}

model Sessao {
  id               String              @id @default(uuid())
  tokenHash        String              @unique @map("token_hash")
  utilizadorId     String?             @map("utilizador_id")
  membroId         String?             @map("membro_id")
  farmaciaAtivaId  String?             @map("farmacia_ativa_id")
  metodo           String              @default("PASSWORD") // PASSWORD | PIN | PASSKEY
  dispositivoId    String?             @map("dispositivo_id")
  ip               String?
  userAgent        String?             @map("user_agent")
  criadaEm         DateTime            @default(now()) @map("criada_em")
  ultimoUsoEm      DateTime            @default(now()) @map("ultimo_uso_em")
  expiraEm         DateTime            @map("expira_em")
  revogadaEm       DateTime?           @map("revogada_em")

  utilizador       Utilizador?         @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  membro           MembroFarmacia?     @relation(fields: [membroId], references: [id], onDelete: Cascade)
  farmaciaAtiva    Farmacia?           @relation(fields: [farmaciaAtivaId], references: [id], onDelete: SetNull)

  @@index([utilizadorId])
  @@index([membroId])
  @@index([expiraEm])
  @@map("sessoes")
}

model DispositivoBalcao {
  id               String              @id @default(uuid())
  farmaciaId       String              @map("farmacia_id")
  nome             String
  tokenHash        String              @unique @map("token_hash")
  emparelhadoPor   String              @map("emparelhado_por")
  emparelhadoEm    DateTime            @default(now()) @map("emparelhado_em")
  ultimoUsoEm      DateTime?           @map("ultimo_uso_em")
  revogadoEm       DateTime?           @map("revogado_em")

  farmacia         Farmacia            @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@index([farmaciaId])
  @@map("dispositivos_balcao")
}

model CodigoEmparelhamento {
  id               String              @id @default(uuid())
  farmaciaId       String              @map("farmacia_id")
  codigoHash       String              @unique @map("codigo_hash")
  criadoPor        String              @map("criado_por")
  expiraEm         DateTime            @map("expira_em")
  usadoEm          DateTime?           @map("usado_em")

  farmacia         Farmacia            @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@index([farmaciaId])
  @@map("codigos_emparelhamento")
}

model DispositivoConfiado {
  id               String              @id @default(uuid())
  utilizadorId     String              @map("utilizador_id")
  tokenHash        String              @unique @map("token_hash")
  expiraEm         DateTime            @map("expira_em")
  revogadoEm       DateTime?           @map("revogado_em")

  utilizador       Utilizador          @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@map("dispositivos_confiados")
}

model CredencialPasskey {
  id              String      @id @default(uuid())
  utilizadorId    String      @map("utilizador_id")
  credentialId    String      @unique @map("credential_id")
  publicKey       Bytes       @map("public_key")
  counter         BigInt      @default(0)
  deviceType      String?     @map("device_type")
  backedUp        Boolean     @default(false) @map("backed_up")
  transports      String[]    @default([])
  nomeAmigavel    String?     @map("nome_amigavel")
  criadoEm        DateTime    @default(now()) @map("criado_em")
  ultimoUsoEm     DateTime?   @map("ultimo_uso_em")
  revogadoEm      DateTime?   @map("revogado_em")

  utilizador      Utilizador  @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@map("credenciais_passkey")
}

model DesafioWebAuthn {
  id           String    @id @default(uuid())
  utilizadorId String?   @map("utilizador_id")
  email        String?
  challenge    String    @unique
  tipo         String    // REGISTO | LOGIN
  expiraEm     DateTime  @map("expira_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  @@index([challenge])
  @@index([expiraEm])
  @@map("desafios_webauthn")
}

model TokenSeguranca {
  id               String              @id @default(uuid())
  tipo             String              // RESET_PASSWORD | RESET_PIN | CONVITE | VERIFICAR_EMAIL | CODIGO_LOGIN | CHALLENGE_LOGIN
  tokenHash        String              @unique @map("token_hash")
  utilizadorId     String?             @map("utilizador_id")
  membroId         String?             @map("membro_id")
  farmaciaId       String?             @map("farmacia_id")
  tentativas       Int                 @default(0)
  expiraEm         DateTime            @map("expira_em")
  usadoEm          DateTime?           @map("usado_em")
  criadoEm         DateTime            @default(now()) @map("criado_em")

  @@index([utilizadorId])
  @@index([farmaciaId])
  @@map("tokens_seguranca")
}

model AuditoriaSeguranca {
  id               String              @id @default(uuid())
  ts               DateTime            @default(now())
  evento           String
  utilizadorId     String?             @map("utilizador_id")
  membroId         String?             @map("membro_id")
  farmaciaId       String?             @map("farmacia_id")
  ip               String?
  userAgent        String?             @map("user_agent")
  detalhes         Json?

  @@index([farmaciaId, ts])
  @@index([utilizadorId, ts])
  @@index([evento, ts])
  @@map("auditoria_seguranca")
}

model ConsentimentoSuporte {
  id                  String           @id @default(uuid())
  farmaciaId          String           @map("farmacia_id")
  utilizadorSuporteId String           @map("utilizador_suporte_id")
  concedidoPor        String           @map("concedido_por")
  expiraEm            DateTime         @map("expira_em")
  revogadoEm          DateTime?        @map("revogado_em")
  criadoEm            DateTime         @default(now()) @map("criado_em")

  farmacia            Farmacia         @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@index([farmaciaId])
  @@index([utilizadorSuporteId])
  @@map("consentimentos_suporte")
}

model ProdutoMestre {
  cnp_codigo              String              @id
  aim                     String?
  designacao              String
  tipo_venda              String?             // MSRM, MNSRM, VENDA_LIVRE
  macro_area              String?             // MSRM, MNSRM_OTC, DERMOCOSMETICA, NUTRICAO_SUPLEMENTOS, DISPOSITIVOS_SAUDE
  categoria               String?             // Nível 2: Família (ex: Alívio da Dor & Febre, Gripes & Vias Respiratórias, etc.)
  subcategoria            String?             // Nível 3: Subcategoria / Sintoma específico (ex: Dor Tópica, Antitússicos, Laxantes)
  sazonalidade            String?             // INVERNO, PRIMAVERA, VERAO, TODO_O_ANO
  gh_codigo               String?             // Código do Grupo Homogéneo
  gh_switch_cnp           String?             // CNP da sugestão switch (maior margem)
  gh_switch_nome          String?             // Designação da sugestão switch
  gh_switch_margem_ganho  Decimal?            @db.Decimal(10, 2) // Ganho unitário (€) ou percentual
  pvp                     Decimal?            @db.Decimal(10, 2)
  margem_padrao           Decimal?            @db.Decimal(10, 2)
  taxa_iva                Int?
  dci                     String?             // DCI / Princípio Ativo (auditado)
  dosagem                 String?             // Dosagem normalizada (ex: 500 mg, 1000 mg)
  forma_farmaceutica      String?             // Forma galénica (Comprimido, Xarope, Gel, etc.)
  embalagem               String?             // Descrição da embalagem / volume
  laboratorio_titular     String?             // Fabricante / Titular de AIM
  indicacoes_clinicas     String?             // Finalidade terapêutica / o que faz
  papel_recomendacao      String?             // TRATAMENTO_PRINCIPAL, ALIVIO_SINTOMATICO, COADJUVANTE_PROTECAO, HIGIENE_BARREIRA
  contraindicacoes_aviso  String?             // Alertas clínicos (ex: duplicado_aines, evitar_hipertensao, etc.)
  fonte_enriquecimento    String?             // INFARMED_OFICIAL, FIRSTPHARMA_HMR, SIFARMA_DESCRICAO
  inventarios             Inventario[]
  inventariosSnapshot     InventarioSnapshot[]
  vendas                  Venda[]
}

// ==========================================
// TABELAS DE STAGING (DADOS BRUTOS)
// ==========================================
model StagingInventario {
  id               String   @id @default(uuid())
  batch_id         String
  farmaciaId       String   
  prat             String?  
  aim              String?  
  codigo           String?  
  designacao       String?  
  lote             String?  
  stock            String?  
  custo_unit       String?  
  valor_s_iva      String?  
  taxa_iva         String?  
  data_extracao    DateTime @default(now())
  processado       Boolean  @default(false)
  erro_validacao   String?

  farmacia         Farmacia @relation(fields: [farmaciaId], references: [id])
  @@index([batch_id])
  @@index([processado])
}

model StagingValidades {
  id               String   @id @default(uuid())
  batch_id         String
  farmaciaId       String   
  
  // Colunas extraídas do PDF de Validades (Raw Strings)
  ord              String?  
  codigo           String?  
  designacao       String?  
  lote             String?  
  stock            String?  
  pratel           String?  
  validade         String?  // Formato bruto: MM-YYYY
  correccao        String?  
  
  data_extracao    DateTime @default(now())
  processado       Boolean  @default(false)
  erro_validacao   String?

  farmacia         Farmacia @relation(fields: [farmaciaId], references: [id])
  @@index([batch_id])
  @@index([processado])
}

model StagingVendas {
  id               String   @id @default(uuid())
  batch_id         String   
  farmaciaId       String   
  codigo_produto   String?
  descricao        String?
  quantidade       String?
  valor_venda      String?
  custo_unitario   String?
  pvp              String?
  margem           String?
  data_movimento   String?  
  data_extracao    DateTime @default(now())
  processado       Boolean  @default(false)
  erro_validacao   String?

  farmacia         Farmacia @relation(fields: [farmaciaId], references: [id])
  @@index([batch_id])
  @@index([processado])
}

// ==========================================
// TABELAS FINAIS (DADOS TRATADOS)
// ==========================================
model Inventario {
  id               String        @id @default(uuid())
  farmaciaId       String
  cnp_codigo       String
  lote             String        @default("LOTE ÚNICO")
  prateleira       String?
  quantidade       Int
  custo_unitario   Decimal       @db.Decimal(10, 2)
  data_validade    DateTime?     // Mapeado a partir do ficheiro de validades
  data_extracao    DateTime      @default(now())
  
  farmacia         Farmacia      @relation(fields: [farmaciaId], references: [id])
  produto          ProdutoMestre @relation(fields: [cnp_codigo], references: [cnp_codigo])

  @@unique([farmaciaId, cnp_codigo, lote])
  @@index([farmaciaId])
  @@index([cnp_codigo])
}

model Venda {
  id               String        @id @default(uuid())
  farmaciaId       String
  cnp_codigo       String
  quantidade       Int
  valor_total      Decimal       @db.Decimal(10, 2)
  data_venda       DateTime
  granularidade    String        @default("MENSAL") // "MENSAL" | "DIARIO"
  
  farmacia         Farmacia      @relation(fields: [farmaciaId], references: [id])
  produto          ProdutoMestre @relation(fields: [cnp_codigo], references: [cnp_codigo])

  @@unique([farmaciaId, cnp_codigo, data_venda, granularidade])
  @@index([farmaciaId])
  @@index([cnp_codigo])
  @@index([data_venda])
  @@index([farmaciaId, granularidade, data_venda])
}

// Histórico de existências de stock por ponto no tempo (Snapshots de fecho ou extração)
model InventarioSnapshot {
  id               String        @id @default(uuid())
  farmaciaId       String
  cnp_codigo       String
  data_snapshot    DateTime
  quantidade       Int
  custo_unitario   Decimal       @db.Decimal(10, 2)
  valor_total      Decimal       @db.Decimal(10, 2)
  data_extracao    DateTime      @default(now())
  
  farmacia         Farmacia      @relation(fields: [farmaciaId], references: [id])
  produto          ProdutoMestre @relation(fields: [cnp_codigo], references: [cnp_codigo])

  @@unique([farmaciaId, cnp_codigo, data_snapshot])
  @@index([farmaciaId, data_snapshot])
  @@index([cnp_codigo])
}

// Preço de venda (PVP) e margem (MG%) praticados por CADA farmácia.
// Nunca partilhado entre farmácias: cada tenant vê apenas os valores do seu próprio ficheiro.
model PrecoFarmacia {
  farmaciaId   String
  cnp_codigo   String
  pvp          Decimal?  @db.Decimal(10, 2)
  margem       Decimal?  @db.Decimal(10, 2)
  custo_ref    Decimal?  @db.Decimal(10, 2)
  atualizadoEm DateTime  @default(now())

  farmacia     Farmacia  @relation(fields: [farmaciaId], references: [id])

  @@id([farmaciaId, cnp_codigo])
  @@index([farmaciaId])
}

// Tarefas Semanais da Equipa (Validades na Gaveta, Restos ao Balcão, Travar Compras, Missões de Campanhas)
model TarefaEquipa {
  id             String    @id @default(uuid())
  farmaciaId     String
  week_key       String
  task_id        String
  categoria      String
  cnp_codigo     String?
  designacao     String?
  concluido      Boolean   @default(true)
  concluido_por  String?
  concluido_em   DateTime  @default(now())
  valor_impacto  Decimal?  @db.Decimal(10, 2)
  campanha_id    String?   // Ligação opcional à CampanhaAtiva (ex: "inverno_barreira_cutanea")

  farmacia       Farmacia  @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, week_key, task_id])
  @@index([farmaciaId, week_key])
  @@index([concluido])
  @@index([campanha_id])
}

// Campanhas Ativas na Farmácia (Escolha do Diretor / Copilot para Execução pela Equipa)
model CampanhaAtiva {
  id                    String    @id @default(uuid())
  farmaciaId            String
  campanhaId            String    // ex: "inverno_barreira_cutanea", "liquidacao_destrava_monos"
  titulo                String
  icone                 String    @default("🎯")
  dataInicio            DateTime  @default(now())
  dataFim               DateTime?
  estado                String    @default("ATIVA") // "ATIVA" | "CONCLUIDA" | "CANCELADA"
  descontoAplicadoPct   Int       @default(15)
  produtosJson          Json      // Lista de CNPs, designações, PVPs normais, PVPs promo e stocks aprovados
  criadoPor             String    @default("Diretor")
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  farmacia              Farmacia  @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@index([farmaciaId, estado])
}

// ==========================================
// TELEMETRIA E FINOPS IA (CONSUMO DE TOKENS)
// ==========================================
model CopilotUsageLog {
  id                          String    @id @default(uuid())
  farmaciaId                  String
  sessionId                   String?
  modelo                      String    // ex: "claude-haiku-4-5-20251001", "claude-3-5-sonnet"
  pergunta                    String    @db.Text
  input_tokens                Int       @default(0)
  output_tokens               Int       @default(0)
  cache_creation_input_tokens Int       @default(0)
  cache_read_input_tokens     Int       @default(0)
  custo_estimado_eur          Decimal   @db.Decimal(10, 5)
  ferramentas_executadas      Json?     // Lista de ferramentas executadas
  duracao_ms                  Int?
  status                      String?   @default("SUCCESS") // "SUCCESS" | "ERROR"
  erro_mensagem               String?   @db.Text
  criadoEm                    DateTime  @default(now())

  farmacia                    Farmacia  @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@index([farmaciaId, criadoEm])
  @@index([criadoEm])
}

// ==========================================
// FASE 0: AUDITORIA E RASTREIO COMPLETO DO COPILOT
// ==========================================
model CopilotInteracao {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmaciaId          String
  utilizadorId        String?
  perfil              String?
  sessionId           String
