# Connection String da Base de Dados (ex: PostgreSQL Local ou Supabase Pooler)
# Desenvolvimento Local: postgresql://postgres:password@localhost:5433/bi_pharma?schema=public
# Produção Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5433/bi_pharma?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5433/bi_pharma?schema=public"

# Pepper versionado para hash HMAC-SHA256 dos PINs de balcão (obrigatório em produção — 32+ bytes hex)
PIN_PEPPER_V1="substituir-por-64-caracteres-hex-aleatorios"

# Chave de cifra AES-256-GCM para segredos TOTP do Superadmin (obrigatório em produção — 32+ bytes hex)
TOTP_ENC_KEY_V1="substituir-por-64-caracteres-hex-aleatorios"

# Email transacional (Resend com domínio bipharma.nuelltech.com)
RESEND_API_KEY="re_sua_chave_dedicada_bi_pharma"
EMAIL_FROM="BI Pharma <info@bipharma.nuelltech.com>"

# Ambiente e Segurança (development | production)
NODE_ENV="development"
# Permitir acesso sem código exclusivo apenas em testes locais (nunca ativar em produção)
ALLOW_DEV_FALLBACK="false"
# Origem permitida para CORS (em produção, definir https://bipharma.nuelltech.com)
ALLOWED_ORIGIN="http://localhost:3000"

# Chave API Anthropic Claude (Opcional - ativa o agente LLM no Copilot)
ANTHROPIC_API_KEY="sk-ant-api03-sua-chave-aqui"
